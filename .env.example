RVS_LISTEN=127.0.0.1:8080
RVS_PUBLIC_URL=http://127.0.0.1:8080
RVS_DATABASE=rosemary.db
RVS_WEB_DIR=web/dist
RVS_DOCS_DIR=docs
RVS_DOWNLOAD_DIR=downloads
RVS_PROJECT_URL=https://github.com/Foodie05/rosemary-virsree
RVS_RELEASE_URL=https://github.com/Foodie05/rosemary-virsree/releases
RVS_ADMIN_TOKEN=change-this-admin-token
RVS_MASTER_KEY=change-this-long-random-master-key
RVS_OIDC_ISSUER=https://apiauth.cruty.cn
RVS_OIDC_CLIENT_ID=replace-with-registered-client-id
RVS_OIDC_CLIENT_SECRET=replace-with-registered-client-secret
RVS_OIDC_REDIRECT_URL=https://storage.example.com/auth/callback
RVS_ADMIN_EMAILS=admin@example.com
RVS_SESSION_TTL_SECONDS=43200
RVS_TOTAL_QUOTA=107374182400
RVS_MAX_OBJECTS_PER_BUCKET=1000000
RVS_MAX_PENDING_UPLOADS_PER_BUCKET=1000
# VirSree 在最高优先级存储源内保存的加密滚动快照。
RVS_BACKUP_INTERVAL_SECONDS=21600
RVS_BACKUP_RETENTION=7

# Optional legacy S3 source. New deployments should leave these blank and add
# one or more verified S3/WebDAV sources in the browser OOBE.
RVS_S3_ENDPOINT=https://s3.example.com
RVS_S3_PUBLIC_ENDPOINT=https://s3.example.com
# Optional S3-compatible download/CDN endpoint. It must preserve SigV4.
RVS_S3_DOWNLOAD_ENDPOINT=
RVS_S3_REGION=us-east-1
RVS_S3_BUCKET=rosemary-private-backing
RVS_S3_ACCESS_KEY=backend-access-key
RVS_S3_SECRET_KEY=backend-secret-key
RVS_S3_PATH_STYLE=true
